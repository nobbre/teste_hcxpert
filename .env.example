# Configurações de ambiente - HCXpert QA Challenge
# Copie este arquivo para .env e preencha com seus valores

# URL Base da Aplicação
BASE_URL=https://www.automationexercise.com

# Credenciais de Teste (usuário padrão)
TEST_USER_EMAIL=test@hcxpert.com
TEST_USER_PASSWORD=Test@123

# API Trello
TRELLO_API_KEY=your_api_key_here
TRELLO_TOKEN=your_token_here

# JIRA Xray Integration (opcional)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=

# Configurações de Evidências
EVIDENCES_DIR=cypress/evidencias
SCREENSHOTS_ENABLED=true
VIDEOS_ENABLED=false

# Timeouts (ms)
DEFAULT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=30000
